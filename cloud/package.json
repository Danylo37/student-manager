{
  "name": "student-manager-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface CloudflareBindings",
    "check": "npm run types && tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply student-manager --local",
    "migrate": "wrangler d1 migrations apply student-manager --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.132.0"
  }
}
