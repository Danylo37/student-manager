{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The built Mini App (stage 3) lands in public/; unknown paths fall back to index.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "student-manager",
      "database_id": "6c000eeb-b43e-4647-8c0e-6435130253dd",
      "migrations_dir": "migrations",
    },
  ],
}
